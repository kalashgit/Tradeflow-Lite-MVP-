{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tradeflow-v05-preview",
  "compatibility_date": "2026-10-13",
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "main": "./src/index.js",
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "DISCOVERY_WORKSPACES",
        "class_name": "DiscoveryWorkspace"
      }
    ]
  },
  "migrations": [
    {
      "tag": "discovery-v1",
      "new_sqlite_classes": [
        "DiscoveryWorkspace"
      ]
    }
  ]
}
