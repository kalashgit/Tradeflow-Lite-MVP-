{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tradeflow-v05-preview",
  "compatibility_date": "2026-10-13",
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "main": "./src/index.js",
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "TF_DB",
      "database_name": "tradeflow-pilot-isolated",
      "database_id": "91eeef63-48d4-4925-a2f1-1a43b164754c"
    }
  ]
}
