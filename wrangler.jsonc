{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tradeflow-v05-preview",
  "compatibility_date": "2026-10-13",
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "main": "./src/index.js",
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "TF_DB",
      "database_name": "tradeflow-pilot-isolated",
      "database_id": "91eeef63-48d4-4925-a2f1-1a43b164754c"
    }
  ],
  "vars": {
    "TF_OIDC_ISSUER": "https://autumn-rain-40ca.cloudflareaccess.com",
    "TF_OIDC_AUDIENCE": "ef0829362f709c1d06f9a2fa4c2b0dbd959a8436e003cc6c8a3e862d40f3bba3",
    "TF_OIDC_JWKS_URL": "https://autumn-rain-40ca.cloudflareaccess.com/cdn-cgi/access/certs",
    "TF_BACKUP_EXPORT_ENABLED": "false",
    "TF_BACKUP_DRY_RUN_ENABLED": "false",
    "TF_EXTENDED_RECORDS_ENABLED": "true"
  }
}
